{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Project Ciel",
  "version": "0.1.0",
  "identifier": "com.projectciel.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Project Ciel",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false,
        "decorations": false,
        "backgroundColor": "#0d0d11"
      },
      {
        "label": "tray-menu",
        "url": "tray-menu.html",
        "width": 208,
        "height": 110,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "visible": false,
        "focus": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "aivtprofile"
        ],
        "name": "ProjectCielProfile",
        "description": "Personaje exportado de Project Ciel"
      },
      {
        "ext": [
          "aivtbackup"
        ],
        "name": "ProjectCielBackup",
        "description": "Copia de seguridad de Project Ciel"
      }
    ],
    "resources": {
      "icons/file-icon.ico": "file-icon.ico",
      "../legal/EULA.es.txt": "legal/EULA.es.txt",
      "../legal/EULA.en.txt": "legal/EULA.en.txt",
      "../legal/EULA.pt.txt": "legal/EULA.pt.txt",
      "../legal/EULA.ja.txt": "legal/EULA.ja.txt",
      "../legal/EULA.ko.txt": "legal/EULA.ko.txt",
      "../legal/EULA.zh.txt": "legal/EULA.zh.txt",
      "../legal/THIRD_PARTY_LICENSES.es.txt": "legal/THIRD_PARTY_LICENSES.es.txt",
      "../legal/THIRD_PARTY_LICENSES.en.txt": "legal/THIRD_PARTY_LICENSES.en.txt",
      "../legal/THIRD_PARTY_LICENSES.pt.txt": "legal/THIRD_PARTY_LICENSES.pt.txt",
      "../legal/THIRD_PARTY_LICENSES.ja.txt": "legal/THIRD_PARTY_LICENSES.ja.txt",
      "../legal/THIRD_PARTY_LICENSES.ko.txt": "legal/THIRD_PARTY_LICENSES.ko.txt",
      "../legal/THIRD_PARTY_LICENSES.zh.txt": "legal/THIRD_PARTY_LICENSES.zh.txt"
    },
    "windows": {
      "nsis": {
        "installerHooks": "installer-hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "languages": [
          "Spanish",
          "English",
          "PortugueseBR",
          "Japanese",
          "Korean",
          "SimpChinese"
        ],
        "displayLanguageSelector": true
      }
    },
    "licenseFile": "installer/license.txt"
  }
}
